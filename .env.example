# Dashboard access (personal use, single shared password)
APP_PASSWORD=change-me
AUTH_SECRET=generate-a-long-random-string-for-cookie-signing

# Cron endpoints (/api/cron/*) — sent as `Authorization: Bearer <value>` by our own
# vercel.ts cron config, checked instead of the password cookie
CRON_SECRET=generate-a-long-random-string

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string

# Database (Postgres via Vercel Marketplace / Neon)
DATABASE_URL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# AI
ANTHROPIC_API_KEY=

# Video providers
HIGGSFIELD_API_KEY=

# Social platforms (filled in once each OAuth app is created)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encryption key for platform tokens at rest (32-byte key, base64)
TOKEN_ENCRYPTION_KEY=
